DATABASE_URL=postgresql+asyncpg://scholar:changeme@localhost:5432/scholar
DATABASE_URL_SYNC=postgresql://scholar:changeme@localhost:5432/scholar
POSTGRES_PASSWORD=changeme

# Paths — update to absolute D drive paths for full dataset
ARXIV_DATA_PATH=./data/arxiv-metadata-oai-snapshot.json
FAISS_INDEX_PATH=./data/faiss.index
EMBEDDINGS_PATH=./data/embeddings.npy
HF_HOME=./data/hf_cache
LORA_ADAPTER_PATH=./data/lora_adapter

# How many papers to ingest (50000 for dev, 200000+ for production)
MAX_PAPERS=50000

# Windows Python 3.13 fix: force UTF-8 for all file I/O (required for trl imports)
PYTHONUTF8=1

# cuda or cpu
DEVICE=cuda

# Set true to enable /explain on CPU (very slow: ~30s/token)
ALLOW_CPU_GENERATION=false

# Set true to pre-load Phi-3 at server startup (avoids cold start on first /explain)
WARMUP_GENERATION=false

# Set true in production: 140s startup but instant queries. False for dev (fast restarts).
WARMUP_RETRIEVAL=true
